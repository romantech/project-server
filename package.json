{
  "name": "project-server",
  "version": "1.0.0",
  "description": "Personal project server that provides a RESTful API",
  "main": "server.ts",
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "_moduleAliases": {
    "@": "dist"
  },
  "scripts": {
    "start:dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node -r module-alias/register dist/server.js",
    "build": "tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm build && node --test",
    "type-check": "tsc --noEmit"
  },
  "engines": {
    "node": "24.*"
  },
  "keywords": [],
  "author": "Romantech",
  "license": "ISC",
  "dependencies": {
    "@langchain/core": "^1.2.7",
    "@langchain/openai": "^1.5.7",
    "@types/request-ip": "^0.0.41",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonrepair": "^3.15.0",
    "langchain": "^1.5.8",
    "module-alias": "^2.3.4",
    "morgan": "^1.11.0",
    "node-schedule": "^2.1.1",
    "openai": "^7.4.0",
    "request-ip": "^3.3.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/module-alias": "^2.0.4",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.2.0",
    "@types/node-schedule": "^2.1.8",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
